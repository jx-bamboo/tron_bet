<div class="col-12 col-lg-6 mb-4 mb-lg-0">
  <div class="card bg-card rounded">
    <div class="card-header bg-transparent border-bottom border-secondary">
      <h5 class="card-title text-light mb-0">最近下注记录</h5>
    </div>
    <div class="card-body p-0">
      <!-- 最近下注记录部分 -->
      <% if @recent_bets.any? %>
        <div class="table-responsive">
          <table class="table table-dark table-hover mb-0">
            <thead>
              <tr>
                <th class="border-0">时间</th>
                <th class="border-0">用户</th>
                <th class="border-0">方向</th>
                <th class="border-0">金额</th>
                <th class="border-0">结果</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_bets.each do |bet| %>
                <tr>
                  <td class="text-nowrap"><%= bet.created_at.strftime('%H:%M') %></td>
                  <td><%= truncate(bet.bot.member.username, length: 8) %></td>
                  <td>
                    <span class="badge bg-<%= bet.bet_parity == "double" ? 'success' : 'danger' %>">
                      <%= bet.result_parity_text %>
                    </span>
                  </td>
                  <td><%= bet.bet_amount %> TRX</td>
                  <td>
                    <% if bet.success.nil? %>
                      <span class="badge bg-warning">等待</span>
                    <% elsif bet.success %>
                      <span class="badge bg-success">✓</span>
                    <% else %>
                      <span class="badge bg-danger">✗</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-4">
          <p class="text-light opacity-50 mb-0">暂无下注记录</p>
        </div>
      <% end %>
    </div>
    <div class="card-footer bg-transparent border-top border-secondary">
      <a href="/bet_records" data-turbo="false" class="btn btn-sm btn-outline-light w-100">查看全部下注记录</a>
    </div>
  </div>
</div>