<div class="col-12 col-lg-6">
  <div class="card bg-card rounded">
    <div class="card-header bg-transparent border-bottom border-secondary">
      <h5 class="card-title text-light mb-0">最新区块</h5>
    </div>
    <div class="card-body p-0">
      <% if @recent_blocks.any? %>
        <div class="table-responsive">
          <table class="table table-dark table-hover mb-0">
            <thead>
              <tr>
                <th class="border-0">时间</th>
                <th class="border-0">区块号</th>
                <th class="border-0">尾数</th>
                <th class="border-0">结果</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_blocks.each do |block| %>
                <tr>
                  <td class="text-nowrap"><%= block.block_time.strftime('%H:%M:%S') %></td>
                  <td><%= block.number %></td>
                  <td><%= block.last_digit %></td>
                  <td>
                    <span class="badge bg-<%= block.parity == 1 ? 'danger' : 'success' %>">
                      <%= block.parity == 1 ? '单' : '双' %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-4">
          <p class="text-light opacity-50 mb-0">暂无区块记录</p>
        </div>
      <% end %>
    </div>
    <div class="card-footer bg-transparent border-top border-secondary">
      <a href="#" data-turbo="false" class="btn btn-sm btn-outline-light w-100">查看全部区块记录</a>
    </div>
  </div>
</div>
