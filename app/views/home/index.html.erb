<%# <div data-controller="auto-refresh" data-auto-refresh-inderval-value="30000"> %>
  <div class="container py-4">
    <!-- 欢迎标题 -->
    <div class="row mb-5">
      <div class="col-12">
        <h1 class="text-light mb-3">TRON 自动化交易系统</h1>
        <p class="text-light opacity-75 mb-0">基于波场链的智能策略执行平台</p>
      </div>
    </div>

    <!-- 系统状态提示 -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="alert alert-<%= @system_status[:status] == 'normal' ? 'success' : 'warning' %> d-flex align-items-center">
          <i class="bi bi-<%= @system_status[:icon] %> me-2"></i>
          <span><%= @system_status[:message] %></span>
          <span class="ms-auto">
            最后区块: <%= @recent_blocks.first&.block_time&.strftime('%H:%M:%S') || '无数据' %>
          </span>
        </div>
      </div>
    </div>

    <!-- 关键数据统计 -->
    <div class="row mb-5">
      <div class="col-6 col-md-3 mb-4">
        <div class="card bg-card text-center p-3 rounded">
          <div class="card-body">
            <h2 class="card-title text-light"><%= @total_members %></h2>
            <p class="card-text text-light opacity-75 mb-1">用户</p>
            <small class="text-light opacity-50"><%= @active_members %> 活跃</small>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3 mb-4">
        <div class="card bg-card text-center p-3 rounded">
          <div class="card-body">
            <h2 class="card-title text-light"><%= @total_bots %></h2>
            <p class="card-text text-light opacity-75 mb-1">机器人</p>
            <small class="text-light opacity-50"><%= @active_bots %> 运行中</small>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3 mb-4">
        <div class="card bg-card text-center p-3 rounded">
          <div class="card-body">
            <h2 class="card-title text-light"><%= @total_blocks %></h2>
            <p class="card-text text-light opacity-75 mb-1">区块</p>
            <small class="text-light opacity-50">今日 <%= @today_blocks %> 条</small>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3 mb-4">
        <div class="card bg-card text-center p-3 rounded">
          <div class="card-body">
            <h2 class="card-title text-light"><%= @total_bets %></h2>
            <p class="card-text text-light opacity-75 mb-1">下注</p>
            <small class="text-light opacity-50">今日 <%= @today_bets %> 笔</small>
          </div>
        </div>
      </div>
    </div>

    <!-- 快速操作 -->
    <div class="row mb-5">
      <div class="col-12">
        <h3 class="text-light mb-4">快速操作</h3>
        <div class="row g-3">
          <div class="col-6 col-md-3">
            <a href="/members" data-turbo="false" class="btn btn-outline-light w-100 py-3 d-flex flex-column align-items-center">
              <i class="bi bi-wallet2 fs-4 mb-2"></i>
              <span>钱包管理</span>
            </a>
          </div>
          <div class="col-6 col-md-3">
            <a href="/home/strategy" data-turbo="false" class="btn btn-outline-light w-100 py-3 d-flex flex-column align-items-center">
              <i class="bi bi-lightning-charge fs-4 mb-2"></i>
              <span>策略说明</span>
            </a>
          </div>
          <div class="col-6 col-md-3">
            <a href="/block_records" data-turbo="false" class="btn btn-outline-light w-100 py-3 d-flex flex-column align-items-center">
              <i class="bi bi-graph-up fs-4 mb-2"></i>
              <span>区块监控</span>
            </a>
          </div>
          <div class="col-6 col-md-3">
            <a href="/bet_records" data-turbo="false" class="btn btn-outline-light w-100 py-3 d-flex flex-column align-items-center">
              <i class="bi bi-currency-exchange fs-4 mb-2"></i>
              <span>下注记录</span>
            </a>
          </div>
        </div>
      </div>
    </div>


    <div class="row mb-5">
      <%= render "home/last_bet" %>
      <%= render "home/last_block" %>
    </div>

    <%= render "home/feature" %>
  </div>
<%# </div> %>
